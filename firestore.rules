rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Wishes collection: anyone can read and write (public wedding wishbook)
    match /wishes/{wishId} {
      // Allow anyone to read all wishes
      allow read: if true;

      // Allow anyone to create a wish, with basic validation
      allow create: if request.resource.data.keys().hasAll(['name', 'wish', 'time', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wish is string
        && request.resource.data.wish.size() > 0
        && request.resource.data.wish.size() <= 500;

      // Nobody can update or delete wishes
      allow update, delete: if false;
    }
  }
}
